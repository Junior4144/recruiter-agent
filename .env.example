# Used by the scripts in ingestion/. Copy to .env and fill in.

# The channel's /videos page
YT_CHANNEL_URL=https://www.youtube.com/@your-channel-handle/videos

GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# GCS prefix where chunk .txt files are staged before import
GCS_CHUNKS_PATH=gs://your-bucket-name/chunks/
